<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="TextViewStyle" parent="android:Widget.TextView">
    <item name="android:fontFamily">sans-serif</item>
  </style>

  <style name="ButtonStyle" parent="android:Widget.Holo.Button">
    <item name="android:fontFamily">sans-serif-light</item>
  </style>

  <style name="DrawerSelectTheme" parent="AppTheme">
  </style>

  <!-- Shows only the counter picker dialog over the home screen -->
  <style name="WidgetConfigureTheme" parent="AppTheme">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowAnimationStyle">@null</item>
  </style>

  <style name="increment_button">
    <item name="android:textSize">90sp</item>
  </style>

  <style name="decrement_button">
    <item name="android:textSize">45sp</item>
  </style>

  <style name="counter_value">
    <item name="android:textColor">?android:attr/textColorPrimary</item>
    <item name="android:textStyle">bold</item>
  </style>

</resources>
